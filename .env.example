# Absolute path to the controlled-access VSL400 release.
VSL400_ROOT=C:/datasets/VSL400

# Absolute path to the extracted ASL Citizen release (contains videos/ and splits/).
ASL_CITIZEN_ROOT=C:/datasets/ASL_Citizen

# OpenMMLab source checkout containing the exact RTMPose and RTMDet config files.
MMPOSE_ROOT=C:/tools/mmpose

# Explicit local checkpoints. Their full SHA-256 values are captured by
# `ss-extract-pose verify` and should be pinned in configs/pose/rtmpose.yaml.
RTMPOSE_L_WHOLEBODY_CHECKPOINT=C:/models/rtmpose-l-coco-wholebody-384x288.pth
RTMDET_M_PERSON_CHECKPOINT=C:/models/rtmdet-m-coco-person.pth
